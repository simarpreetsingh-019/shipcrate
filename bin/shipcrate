#!/bin/sh
# shipcrate: releases and updates for your products, in one command.
#
# Set up a project:
#   shipcrate new <kind> <dir> [--name N] [--repo owner/name]   start a ready-to-release project
#                                      (kind: rust-cli | python-cli | node-cli | macos-app)
#   shipcrate init [dir] [options]     add the release tooling to an existing repo ("shipcrate init --help")
#   shipcrate doctor                   check this project's setup and explain any fixes
#   shipcrate sync [--dry-run]         refresh shipcrate's own files in a project from this shipcrate release
#   shipcrate sync --show FILE         compare one of your files (install.sh, a workflow…) with shipcrate's version
#
# Every day (run inside a project; they call the project's own scripts/):
#   shipcrate check [--quick|--release]        the quality gate
#   shipcrate changelog [--write|--version]    next version + CHANGELOG section from your commits
#   shipcrate release <X.Y.Z|auto> [--dry-run] [--security] [--rollout N] [--rollout-days D] [--yes]
#   shipcrate rollout <percent> [--days D]     widen (or time) a staged rollout
#   shipcrate yank <X.Y.Z> [--to GOOD] [--reason "…"]   pull a bad release; users are moved back
#   shipcrate announce "message" [--level …] [--url …] [--below X.Y.Z] | --clear
#   shipcrate status                           settings + what's live (version, rollout, yanked, message)
#   shipcrate stats [--baseline] [--history F] [--repo owner/name]   download numbers from GitHub (no tracking)
#   shipcrate keygen                           make the signing key for signed updates
#
# Other:
#   shipcrate demo                     60-second offline demo        shipcrate mcp       run the MCP server (stdio)
#   shipcrate self-update              update shipcrate itself       shipcrate version
set -eu
KIT_VERSION=0.4.0
# Resolve symlinks (Homebrew and ~/.local/bin install a link to this file).
SELF="$0"; while [ -L "$SELF" ]; do L=$(readlink "$SELF"); case "$L" in /*) SELF="$L" ;; *) SELF="$(dirname "$SELF")/$L" ;; esac; done
KIT=$(cd "$(dirname "$SELF")/.." && pwd)
T="$KIT/templates"
say() { printf '%s\n' "$*"; }
die() { say "shipcrate: $*" >&2; exit 1; }

usage() { sed -n '2,27p' "$SELF" | sed 's/^# \{0,1\}//'; }
init_usage() { sed -n '/^# init options/,/^# Dependency-free/p' "$SELF" | sed 's/^# \{0,1\}//'; }

# The project root: the nearest folder (from here up) with a release.conf.
project() {
  d=$(pwd)
  while [ "$d" != / ]; do [ -f "$d/release.conf" ] && { echo "$d"; return 0; }; d=$(dirname "$d"); done
  die "no release.conf here or above: run this inside a project set up with 'shipcrate init'"
}
script() { # script NAME args… : run the project's own scripts/NAME.sh
  n="$1"; shift; P=$(project)
  [ -f "$P/scripts/$n.sh" ] || die "$P/scripts/$n.sh is missing: rerun 'shipcrate init' there to add new scripts (existing files are kept)"
  cd "$P" && exec sh "scripts/$n.sh" "$@"
}

doctor() {
  P=$(project); cd "$P"; . ./release.conf; bad=0
  ok() { printf '  ✔ %s\n' "$1"; }
  no() { printf '  ✗ %s\n    → %s\n' "$1" "$2"; bad=$((bad+1)); }
  say "shipcrate doctor: $PRODUCT ($TYPE, $KIT_LANG) in $P"
  git rev-parse --git-dir >/dev/null 2>&1 && ok "git repository" || no "not a git repository" "git init && git remote add origin https://github.com/$REPO"
  command -v gh >/dev/null 2>&1 && ok "GitHub CLI installed" || no "GitHub CLI missing" "brew install gh   (Windows: winget install GitHub.cli)"
  gh auth status >/dev/null 2>&1 && ok "gh signed in" || no "gh not signed in" "gh auth login"
  git remote get-url origin 2>/dev/null | grep -q "$REPO" && ok "origin is $REPO" || no "origin isn't github.com/$REPO" "git remote set-url origin https://github.com/$REPO (or fix REPO in release.conf)"
  for f in check release build-release manifest release-notes; do [ -f "scripts/$f.sh" ] || { no "scripts/$f.sh missing" "shipcrate init . (adds missing files, keeps yours)"; }; done
  [ "$(git config core.hooksPath 2>/dev/null)" = .githooks ] && ok "git hooks on" || no "git hooks off" "sh scripts/install-hooks.sh"
  [ -f .github/workflows/ci.yml ] && [ -f .github/workflows/release.yml ] && ok "CI and release workflows" || no "workflows missing" "shipcrate init ."
  [ -e "$ARTIFACT" ] && ok "build output found ($ARTIFACT)" || printf '  • build output %s not built yet (run: %s)\n' "$ARTIFACT" "$BUILD_CMD"
  grep -Eq '^## \[?v?[0-9]' CHANGELOG.md 2>/dev/null && ok "CHANGELOG has versions" || no "CHANGELOG.md has no version sections" "shipcrate changelog --write"
  if grep -rqsE 'update::notify|update_check\.notify|update\.notify|Updater\.shared|UpdateButton' --include='*.rs' --include='*.py' --include='*.js' --include='*.ts' --include='*.swift' . 2>/dev/null; then ok "update check wired into the code"
  else no "update check not wired into your code yet" "see the comment at the top of the file in updater/"; fi
  if grep -q "^PUBLIC_KEY='[A-Za-z0-9+/=]\{40,\}'" release.conf 2>/dev/null; then ok "signed updates on"; else printf '  • signed updates off (recommended): shipcrate keygen\n'; fi
  if [ "$TAP_REPO" != none ]; then gh repo view "$TAP_REPO" >/dev/null 2>&1 && ok "Homebrew tap $TAP_REPO exists" || no "Homebrew tap $TAP_REPO doesn't exist yet" "gh repo create $TAP_REPO --public (the first release fills it)"; fi
  if gh run list --workflow ci.yml --limit 1 --json conclusion -q '.[0].conclusion' 2>/dev/null | grep -q success; then ok "last CI run passed"; else printf '  • no passing CI run yet: push and check the Actions tab\n'; fi
  compare_pieces
  say ""; [ $bad = 0 ] && say "All good. Next: shipcrate release <version> --dry-run" || say "$bad thing(s) to fix."
  return $bad
}

# Is this shipcrate an actual release? (a Homebrew/tarball install is; a git checkout must sit on a vX.Y.Z tag)
kit_release() {
  if [ -d "$KIT/.git" ]; then git -C "$KIT" describe --tags --exact-match 2>/dev/null | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$'
  else return 0; fi
}

# Your own pieces next to shipcrate's: keep them, and explain what shipcrate's version would change.
compare_pieces() {
  say ""; say "Your own pieces (kept as they are; shipcrate never replaces them without asking):"
  if [ -f install.sh ] && ! grep -q '^# shipcrate-installer: ' install.sh; then
    say "  • install.sh is yours. shipcrate's installer adds: reads the signed release manifest, checks SHA-256 and"
    say "    GitHub provenance, picks the right build per platform, keeps the old copy for rollback."
    say "    Compare: shipcrate sync --show install.sh"
  fi
  for c in $(grep -rls 'shipcrate:public-key' --include='*.rs' --include='*.py' --include='*.js' --include='*.ts' --include='*.swift' . 2>/dev/null | grep -v -E '^\./updater/|node_modules' || true); do
    say "  • ${c#./} is your copy of the updater: update it from updater/ when you choose (diff updater/ ${c#./})."
  done
  if [ -f release.sh ] && ! grep -q 'scripts/release.sh' release.sh 2>/dev/null; then
    say "  • release.sh is yours: shipcrate's safety rules (beta first, update-path test, slow rollout, keep download"
    say "    names) only run through scripts/release.sh. Call it from yours to get them."
  fi
  if ! grep -q "^PUBLIC_KEY='[A-Za-z0-9+/=]\{40,\}'" release.conf 2>/dev/null; then
    say "  • Signed updates are off. Today your app trusts a latest.json that comes over HTTPS from your GitHub"
    say "    releases and whose checksums match. With signed updates it also needs your signature (Ed25519), so even"
    say "    someone who got into your GitHub account or a mirror couldn't push an update. Nothing changes for copies"
    say "    already installed until they update. The cost: keep the private key safe; if it's lost, users must"
    say "    reinstall once. Turn on: sh scripts/keygen.sh (it explains and asks again)."
  fi
}

# Refresh the files shipcrate owns (scripts/, tests/shipcrate/, .githooks/, updater/) from this shipcrate version.
# Everything else (release.conf values, workflows, installers, your code) is left alone and only reported.
sync_project() {
  DRYS=0; YESS=0; DEV=0; SHOW=""; NEXTA=""
  for a in "$@"; do
    if [ "$NEXTA" = show ]; then SHOW="$a"; NEXTA=""; continue; fi
    case "$a" in --dry-run|-n) DRYS=1 ;; --yes|-y) YESS=1 ;; --allow-dev) DEV=1 ;; --show) NEXTA=show ;; *) die "sync: unknown option $a" ;; esac
  done
  P=$(project); cd "$P"; . ./release.conf
  if ! kit_release && [ $DEV = 0 ]; then
    die "this shipcrate ($KIT) isn't a release (rule: sync only from releases). Install a release (brew upgrade shipcrate / shipcrate self-update), or pass --allow-dev for a throwaway copy"
  fi
  DESCS=$(sed -n 's/^  desc "\(.*\)"$/\1/p' packaging/homebrew/*.rb 2>/dev/null | head -1)
  W=$(mktemp -d); trap 'rm -rf "${W:?}"' EXIT
  set -- --yes --name "$PRODUCT" --type "$TYPE" --lang "$KIT_LANG" --repo "$REPO" --tap "$TAP_REPO"
  [ -n "$DESCS" ] && set -- "$@" --desc "$DESCS"
  [ "$TYPE" = cli ] && set -- "$@" --targets "$TARGETS"
  [ "$TYPE" = app ] && [ "$BUNDLE_ID" != none ] && set -- "$@" --bundle-id "$BUNDLE_ID"
  mkdir -p "$W/new"; sh "$KIT/bin/shipcrate" init "$W/new" "$@" >/dev/null || die "sync: couldn't generate the new files"
  if [ -n "$SHOW" ]; then   # compare one of your files with shipcrate's current version of it; changes nothing
    [ -f "$W/new/$SHOW" ] || die "shipcrate has no $SHOW for this project"
    if [ -f "$SHOW" ]; then diff -u "$SHOW" "$W/new/$SHOW" | sed "2s|^+++ .*|+++ shipcrate's $SHOW|" || true; else cat "$W/new/$SHOW"; fi
    return 0
  fi
  say "shipcrate sync: ${SHIPCRATE_VERSION:-unknown} → $KIT_VERSION ($P)"
  # .shipcrate/files.sha256 remembers what sync wrote last time: a file that no longer matches was edited by you.
  REC=.shipcrate/files.sha256; : > "$W/apply"; : > "$W/edited"
  sha() { if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1"; else sha256sum "$1"; fi | cut -d' ' -f1; }
  for f in $(cd "$W/new" && find scripts tests/shipcrate .githooks updater -type f 2>/dev/null | sort); do
    if [ ! -f "$f" ]; then say "  + $f (new)"; echo "$f" >> "$W/apply"
    elif ! cmp -s "$W/new/$f" "$f"; then
      n=$(diff "$f" "$W/new/$f" | grep -c '^[<>]')
      if grep -q "^$(sha "$f")  $f\$" "$REC" 2>/dev/null; then say "  ~ $f ($n lines differ)"; echo "$f" >> "$W/apply"
      else say "  ✎ $f has your own edits ($n lines differ from the new version)"; echo "$f" >> "$W/edited"; fi
    fi
  done
  changed=$(($(wc -l < "$W/apply") + $(wc -l < "$W/edited")))
  copies=$(grep -rls 'shipcrate:public-key' --include='*.rs' --include='*.py' --include='*.js' --include='*.ts' --include='*.swift' . 2>/dev/null | grep -v -E '^\./updater/|node_modules' || true)
  for c in $copies; do say "  ! $c is your copy of the updater: update it from updater/ yourself (diff it; your changes are kept)"; done
  for f in .github/workflows/ci.yml .github/workflows/release.yml install.sh SECURITY.md; do
    [ -f "$W/new/$f" ] && [ -f "$f" ] && ! cmp -s "$W/new/$f" "$f" && say "  · $f differs from the new template (not synced: yours to compare)"
  done
  [ $changed = 0 ] && say "  nothing to update in shipcrate's own files"
  compare_pieces
  if [ $DRYS = 1 ]; then say ""; say "Dry run: nothing changed."; return 0; fi
  if [ -s "$W/apply" ] && [ $YESS = 0 ]; then printf 'Update the %s unedited file(s)? [y/N] ' "$(wc -l < "$W/apply" | tr -d ' ')"; read -r ok </dev/tty; case "$ok" in y|Y|yes) ;; *) say "cancelled"; return 1 ;; esac; fi
  while IFS= read -r f; do [ -n "$f" ] && mkdir -p "$(dirname "$f")" && cp -p "$W/new/$f" "$f"; done < "$W/apply"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ $YESS = 1 ]; then say "  kept your edited $f (compare: diff $f <(new)); rerun without --yes to choose"; continue; fi
    diff -u "$f" "$W/new/$f" | head -40
    printf '%s has your edits. Replace it with the new version (your edits are lost; they stay in git history)? [y/N] ' "$f"
    read -r ok </dev/tty; case "$ok" in y|Y|yes) cp -p "$W/new/$f" "$f"; say "  replaced $f" ;; *) say "  kept $f" ;; esac
  done < "$W/edited"
  # remember what's now in place (edited files keep their current checksum, so they stay "yours")
  mkdir -p .shipcrate
  (cd "$W/new" && find scripts tests/shipcrate .githooks updater -type f 2>/dev/null | sort) | while IFS= read -r f; do
    [ -f "$f" ] && cmp -s "$W/new/$f" "$f" && printf '%s  %s\n' "$(sha "$f")" "$f"
  done > "$REC"
  # keep signed updates on: put this project's public key back into the fresh updater files
  if [ -n "${PUBLIC_KEY:-}" ]; then for f in updater/*; do [ -f "$f" ] && sed -E "/shipcrate:public-key/s|\"[A-Za-z0-9+/=]*\"|\"$PUBLIC_KEY\"|" "$f" > "$f.new" && mv "$f.new" "$f"; done; fi
  if grep -q '^SHIPCRATE_VERSION=' release.conf; then sed "s/^SHIPCRATE_VERSION=.*/SHIPCRATE_VERSION='$KIT_VERSION'/" release.conf > release.conf.new && mv release.conf.new release.conf
  else printf "\n# The shipcrate release these files came from (shipcrate sync updates it).\nSHIPCRATE_VERSION='%s'\n" "$KIT_VERSION" >> release.conf; fi
  say "✓ synced to shipcrate $KIT_VERSION. Next: review (git diff), run the gate, and release a beta first."
}

status() {
  P=$(project); cd "$P"; . ./release.conf
  say "$PRODUCT · $TYPE · $KIT_LANG · github.com/$REPO · targets: $TARGETS · builds: $BUILD_WHERE"
  say "tap: $TAP_REPO · signed updates: $(grep -q "^PUBLIC_KEY='[A-Za-z0-9+/=]\{40,\}'" release.conf && echo on || echo off)"
  say "last tag: $(git tag -l 'v[0-9]*' --sort=-v:refname | head -1)"
  J=$(gh release download --repo "$REPO" --pattern latest.json --output - 2>/dev/null) || { say "live: no published release (or gh isn't signed in)"; return 0; }
  printf '%s\n' "$J" | awk '
    /"version":/ { gsub(/[",]/, ""); print "live: " $2 }
    /"rollout":/ { gsub(/[",]/, ""); print "rollout: " $2 "%" }
    /"rollout_days":/ { gsub(/[",]/, ""); print "timed rollout: " $2 " days" }
    /"security": true/ { print "security release: yes" }
    /"yanked":/ { sub(/^[^[]*/, ""); print "yanked: " $0 }
    /"announcement":/ { m = $0; sub(/.*"message": "/, "", m); sub(/", "url".*/, "", m); print "announcement: " m }
    /^    "[a-z0-9-]+": \{/ { t = $1; gsub(/[":]/, "", t); plats = plats " " t }
    END { if (plats != "") print "platforms:" plats }'
}

cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  init) case "${1:-}" in -h|--help) init_usage; exit 0 ;; esac ;;
  check) script check "$@" ;;
  changelog) script changelog "$@" ;;
  release) script release "$@" ;;
  rollout) script rollout "$@" ;;
  yank) script yank "$@" ;;
  announce) script announce "$@" ;;
  keygen) script keygen "$@" ;;
  stats) if [ "${1:-}" = --repo ]; then R="${2:?--repo owner/name}"; shift 2; SHIPCRATE_REPO="$R" exec sh "$T/common/scripts/stats.sh" "$@"; fi
         script stats "$@" ;;
  new)
    KIND="${1:-}"; DIR="${2:-}"
    case "$KIND" in rust-cli|python-cli|node-cli|macos-app) ;; *) die "usage: shipcrate new <rust-cli|python-cli|node-cli|macos-app> <dir> [--name N] [--repo owner/name]" ;; esac
    [ -n "$DIR" ] || die "usage: shipcrate new $KIND <dir>"
    [ -e "$DIR" ] && [ -n "$(ls -A "$DIR" 2>/dev/null)" ] && die "$DIR already exists and isn't empty"
    shift 2
    W=$(mktemp -d); trap 'rm -rf "${W:?}"' EXIT
    sh "$KIT/tools/make-templates.sh" "$W" --only "$KIND" >/dev/null
    mkdir -p "$DIR" && cp -R "$W/shipcrate-template-$KIND/." "$DIR/"
    cd "$DIR"; git init -q 2>/dev/null || true
    sh setup.sh "$@"
    exit 0 ;;
  sync) sync_project "$@"; exit $? ;;
  status) status; exit 0 ;;
  doctor) doctor; exit $? ;;
  demo) exec sh "$KIT/examples/demo.sh" ;;
  mcp) exec node "$KIT/mcp/server.js" ;;
  self-update)
    if [ -d "$KIT/.git" ]; then git -C "$KIT" pull --ff-only -q && say "✓ shipcrate $(sh "$KIT/bin/shipcrate" version | cut -d' ' -f2)"
    elif command -v brew >/dev/null && brew list shipcrate >/dev/null 2>&1; then brew upgrade shipcrate
    else die "reinstall with the installer: https://github.com/simarpreetsingh-019/shipcrate#install"; fi
    exit 0 ;;
  version|--version|-v) say "shipcrate $KIT_VERSION"; exit 0 ;;
  ""|help|-h|--help) usage; exit 0 ;;
  *) say "shipcrate: unknown command '$cmd'" >&2; usage; exit 2 ;;
esac

# ---------------------------------------------------------------- init
# init options (anything missing is asked for when run in a terminal):
#   --name NAME        product name, e.g. "Thermo" or "msh"
#   --type app|cli     macOS .app with a Homebrew cask, or a command-line tool with a Homebrew formula
#   --lang LANG        rust | swift | python | node
#   --repo OWNER/NAME  GitHub repository of the product
#   --tap OWNER/NAME   Homebrew tap repository (default OWNER/homebrew-<name>; "none" for no tap)
#   --desc TEXT        one-line description (Homebrew desc)
#   --bundle-id ID     app only: CFBundleIdentifier
#   --targets "LIST"   cli: platforms to build, e.g. "macos-arm64 linux-x64 windows-x64" (default depends on language)
#   --dry-run          print what would be written; write nothing
#   --yes              don't ask: use defaults and skip files that already exist
#   --force            with --yes: overwrite existing files (without --yes you are asked per file)
# Dependency-free POSIX sh. Writes only inside the target directory; never touches the network.

TARGET=.; NAME=""; TYPE=""; KLANG=""; REPO=""; TAP=""; DESC=""; BUNDLE=""; TARGETS=""; DRY=0; YES=0; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --name) NAME="${2:?}"; shift ;;  --type) TYPE="${2:?}"; shift ;;  --lang) KLANG="${2:?}"; shift ;;
    --repo) REPO="${2:?}"; shift ;;  --tap) TAP="${2:?}"; shift ;;    --desc) DESC="${2:?}"; shift ;;
    --bundle-id) BUNDLE="${2:?}"; shift ;;  --targets) TARGETS="${2:?}"; shift ;;
    --dry-run|-n) DRY=1 ;; --yes|-y) YES=1 ;; --force) FORCE=1 ;;
    -h|--help) init_usage; exit 0 ;;
    -*) die "unknown option $1" ;;
    *) TARGET="$1" ;;
  esac
  shift
done

INTERACTIVE=0; [ $YES = 0 ] && [ -t 0 ] && INTERACTIVE=1
ask() { # ask VAR "Question" default
  eval "cur=\${$1}"
  [ -n "$cur" ] && return 0
  if [ $INTERACTIVE = 1 ]; then
    printf '%s%s: ' "$2" "${3:+ [$3]}"; read -r ans; [ -n "$ans" ] || ans="${3:-}"
  else ans="${3:-}"; fi
  [ -n "$ans" ] || die "missing --$(echo "$1" | tr 'A-Z' 'a-z')"
  eval "$1=\$ans"
}

[ -d "$TARGET" ] || die "target folder $TARGET doesn't exist"
TARGET=$(cd "$TARGET" && pwd)
GUESS_REPO=$(git -C "$TARGET" remote get-url origin 2>/dev/null | sed -E 's#^(https://github.com/|git@github.com:)##; s#\.git$##' || true)
GUESS_LANG=""
[ -f "$TARGET/Cargo.toml" ] && GUESS_LANG=rust
[ -f "$TARGET/Package.swift" ] || ls "$TARGET"/*.xcodeproj >/dev/null 2>&1 && GUESS_LANG=${GUESS_LANG:-swift}
[ -f "$TARGET/pyproject.toml" ] && GUESS_LANG=${GUESS_LANG:-python}
[ -f "$TARGET/package.json" ] && GUESS_LANG=${GUESS_LANG:-node}

ask NAME "Product name" "$(basename "$TARGET")"
ask TYPE "Type: app (macOS .app) or cli" "cli"
case "$TYPE" in app|cli) ;; *) die "--type must be app or cli" ;; esac
ask KLANG "Language: rust, swift, python or node" "${GUESS_LANG:-$([ "$TYPE" = app ] && echo swift || echo rust)}"
case "$KLANG" in rust|swift|python|node) ;; *) die "--lang must be rust, swift, python or node" ;; esac
[ "$TYPE" = app ] && [ "$KLANG" != swift ] && die "app type supports swift (macOS .app); use --type cli for $KLANG"
TOKEN=$(printf '%s' "$NAME" | tr 'A-Z ' 'a-z-' | tr -cd 'a-z0-9._-')
[ -n "$TOKEN" ] || die "product name needs letters or digits"
ask REPO "GitHub repository (owner/name)" "$GUESS_REPO"
echo "$REPO" | grep -Eq '^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$' || die "--repo must look like owner/name"
OWNER=${REPO%%/*}
ask TAP "Homebrew tap repository (owner/homebrew-name, or none)" "$OWNER/homebrew-$TOKEN"
[ "$TAP" = none ] || echo "$TAP" | grep -Eq '^[A-Za-z0-9_.-]+/homebrew-[A-Za-z0-9_.-]+$' || die "--tap must look like owner/homebrew-name, or none"
ask DESC "One-line description" "$NAME"
if [ "$TYPE" = app ]; then ask BUNDLE "Bundle identifier" "com.$(printf '%s' "$OWNER" | tr 'A-Z' 'a-z' | tr -cd 'a-z0-9-').$TOKEN"; fi

BINARY=$TOKEN
MODULE=$(printf '%s' "$TOKEN" | tr '.-' '__')
CLASS=$(printf '%s' "$TOKEN" | awk -F'[-_.]' '{for(i=1;i<=NF;i++) printf "%s%s", toupper(substr($i,1,1)), substr($i,2)}')
case "$CLASS" in [0-9]*) CLASS="A$CLASS" ;; esac
ENVP=$(printf '%s' "$TOKEN" | tr 'a-z.-' 'A-Z__')
if [ "$TYPE" = app ]; then
  TARGETS=macos; ASSET="$NAME.zip"; TAP_FILE="Casks/$TOKEN.rb"; RUNNER=macos-latest; BUILD_WHERE=local
  BUILD_CMD="sh build.sh"; ARTIFACT="build/$NAME.app"
  VERSION_CMD='/usr/libexec/PlistBuddy -c "Set :CFBundleShortVersionString $V" Info.plist'
else
  TAP_FILE="Formula/$TOKEN.rb"; BUILD_WHERE=ci
  case "$KLANG" in
    rust)   D_TARGETS="macos-arm64 macos-x64 linux-x64 linux-arm64 windows-x64"; ASSET="$TOKEN-{target}.tar.gz"; RUNNER=ubuntu-latest
            BUILD_CMD="cargo build --release --locked"; ARTIFACT="target/release/$BINARY"
            VERSION_CMD='sed -i.bak -E "1,/^version = /s/^version = \".*\"/version = \"$V\"/" Cargo.toml && rm -f Cargo.toml.bak && cargo update -w -q' ;;
    swift)  D_TARGETS="macos-arm64 macos-x64 linux-x64"; ASSET="$TOKEN-{target}.tar.gz"; RUNNER=macos-latest
            BUILD_CMD="swift build -c release"; ARTIFACT=".build/release/$BINARY"
            VERSION_CMD="echo \"let appVersion = \\\"\$V\\\"\" > Sources/$BINARY/Version.swift" ;;
    python) D_TARGETS="any"; ASSET="$TOKEN.tar.gz"; RUNNER=ubuntu-latest
            BUILD_CMD="mkdir -p build && python3 -m zipapp src -m \"$MODULE.__main__:main\" -p \"/usr/bin/env python3\" -o build/$BINARY"
            ARTIFACT="build/$BINARY"
            VERSION_CMD='sed -i.bak -E "1,/^version = /s/^version = \".*\"/version = \"$V\"/" pyproject.toml && rm -f pyproject.toml.bak' ;;
    node)   D_TARGETS="any"; ASSET="$TOKEN.tar.gz"; RUNNER=ubuntu-latest
            BUILD_CMD="npm ci --silent && npm run build --if-present --silent"; ARTIFACT="dist/$BINARY"
            VERSION_CMD='npm version "$V" --no-git-tag-version --allow-same-version' ;;
  esac
fi

if [ "$TYPE" = cli ]; then
  TARGETS=${TARGETS:-$D_TARGETS}
  for t in $TARGETS; do case "$t" in macos-arm64|macos-x64|linux-x64|linux-arm64|windows-x64|windows-arm64|any) ;; *) die "unknown target $t (use macos-arm64 macos-x64 linux-x64 linux-arm64 windows-x64 windows-arm64 any)" ;; esac; done
  case " $TARGETS " in *" any "*) [ "$TARGETS" = any ] || die "'any' can't be combined with other targets" ;; esac
  [ "$TARGETS" = any ] && ASSET=$(printf '%s' "$ASSET" | sed 's/-{target}//')
fi

# Homebrew formula url/sha256 lines per target (macOS and Linux; Homebrew doesn't do Windows).
URLS=$(mktemp)
fline() { a=$(printf '%s' "$ASSET" | sed "s/{target}/$2/g"); printf '%surl "https://github.com/%s/releases/download/v#{version}/%s"\n%ssha256 "%064d" # shipcrate:%s\n' "$1" "$REPO" "$a" "$1" 0 "$2"; }
{
  if [ "$TARGETS" = any ]; then fline "  " any
  else
    for os in macos linux; do
      ts=""; for t in $TARGETS; do case "$t" in "$os"-*) ts="$ts $t" ;; esac; done
      [ -n "$ts" ] || continue
      printf '  on_%s do\n' "$os"
      for t in $ts; do case "$t" in *-arm64) printf '    on_arm do\n' ;; *) printf '    on_intel do\n' ;; esac; fline "      " "$t"; printf '    end\n'; done
      printf '  end\n'
    done
  fi
} > "$URLS"

# --- Fill placeholders: one sed script, values escaped for the | delimiter.
SED=$(mktemp); trap 'rm -f "${SED:?}" "${URLS:?}"' EXIT
put() { printf 's|{{%s}}|%s|g\n' "$1" "$(printf '%s' "$2" | sed 's/[\\|&]/\\&/g')" >> "$SED"; }
put PRODUCT "$NAME"; put TOKEN "$TOKEN"; put TYPE "$TYPE"; put LANG "$KLANG"; put REPO "$REPO"; put OWNER "$OWNER"
put TAP_REPO "$TAP"; put TAP_FILE "$TAP_FILE"; put BINARY "$BINARY"; put BUNDLE_ID "${BUNDLE:-none}"; put ASSET "$ASSET"
put BUILD_CMD "$BUILD_CMD"; put ARTIFACT "$ARTIFACT"; put VERSION_CMD "$VERSION_CMD"; put BUILD_WHERE "$BUILD_WHERE"
put RUNNER "$RUNNER"; put CLASS "$CLASS"; put ENV "$ENVP"; put DESCRIPTION "$(printf '%s' "$DESC" | tr -d '"')"; put MODULE "$MODULE"; put TARGETS "$TARGETS"; put KIT_VERSION "$KIT_VERSION"

# --- File list: "template-path target-path" per line.
LIST=$(cd "$T/common" && find . -type f | sed 's#^\./##' | sort | awk '{print "common/" $0 " " $0}')
if [ "$TYPE" = app ]; then LIST="$LIST
app/packaging/homebrew/cask.rb packaging/homebrew/$TOKEN.rb
updaters/swift/Updater.swift updater/Updater.swift
updaters/tests/UpdaterTests.swift tests/shipcrate/UpdaterTests.swift"
else LIST="$LIST
cli/packaging/homebrew/formula.rb packaging/homebrew/$TOKEN.rb"
  case "$KLANG" in
    rust)   LIST="$LIST
updaters/rust/update.rs updater/update.rs" ;;
    python) LIST="$LIST
updaters/python/update_check.py updater/update_check.py
updaters/tests/test_update_check.py tests/shipcrate/test_update_check.py" ;;
    node)   LIST="$LIST
updaters/node/update-check.js updater/update-check.js
updaters/tests/update-check.test.js tests/shipcrate/update-check.test.js" ;;
    swift)  LIST="$LIST
updaters/rust/update.rs updater/REFERENCE-update.rs" ;;
  esac
fi

case " $TARGETS " in *" windows-"*) LIST="$LIST
cli/install.ps1 install.ps1" ;; esac

say "shipcrate $KIT_VERSION → $TARGET"
say "  $NAME ($TYPE, $KLANG) · github.com/$REPO · tap: $TAP · targets: $TARGETS"
[ $DRY = 1 ] && say "  dry run: nothing will be written"
WROTE=0; SKIPPED=0
printf '%s\n' "$LIST" | while read -r src dst; do
  out="$TARGET/$dst"
  if [ -e "$out" ]; then
    if [ $DRY = 1 ]; then say "  exists (would ask)  $dst"; continue; fi
    if [ $YES = 1 ]; then
      [ $FORCE = 1 ] || { say "  skipped (exists)    $dst"; continue; }
    elif [ -t 0 ]; then
      printf '  %s exists. Overwrite? [y/N] ' "$dst"; read -r ok </dev/tty
      case "$ok" in y|Y|yes) ;; *) say "  kept                $dst"; continue ;; esac
    else say "  skipped (exists)    $dst"; continue; fi
  fi
  if [ $DRY = 1 ]; then say "  would write         $dst"; continue; fi
  mkdir -p "$(dirname "$out")"
  sed -f "$SED" "$T/$src" | awk -v f="$URLS" '/#SHIPCRATE_URLS/ {while ((getline l < f) > 0) print l; next} {print}' > "$out"
  case "$dst" in *.sh|.githooks/*) chmod 755 "$out" ;; esac
  say "  wrote               $dst"
done
[ $DRY = 1 ] && exit 0
( cd "$TARGET" && mkdir -p .shipcrate && for f in $(find scripts tests/shipcrate .githooks updater -type f 2>/dev/null | sort); do
    printf '%s  %s\n' "$( (shasum -a 256 "$f" 2>/dev/null || sha256sum "$f") | cut -d' ' -f1)" "$f"; done > .shipcrate/files.sha256 )
# Build output must never be committed (and must not make the tree look dirty before a release).
if ! grep -qxE '/?dist/?' "$TARGET/.gitignore" 2>/dev/null; then printf 'dist/\n' >> "$TARGET/.gitignore"; say "  added dist/ to       .gitignore"; fi
say ""
say "Next (the same order /shipcrate:setup follows):"
say "  1. release.conf: check BUILD_CMD, ARTIFACT and VERSION_CMD match your build."
say "  2. Wire in the update check: move the file from updater/ into your code (its top comment shows how)."
say "  3. Signed updates (recommended): sh scripts/keygen.sh"
say "  4. sh scripts/install-hooks.sh && sh scripts/check.sh"
say "  5. Commit, push, then: sh scripts/release.sh 0.1.0 --dry-run"
